# ####################################################################
# 1. Dependencies
# ####################################################################
# Block heavy package folders from being uploaded to GitHub
node_modules/
jspm_packages/

# ####################################################################
# 2. Build Outputs
# ####################################################################
# Production build folders for Vite, Create React App, and Next.js
dist/
build/
.next/
out/
.docusaurus/

# ####################################################################
# 3. Environment Variables & Secrets
# ####################################################################
# Block real API keys and database credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# DO NOT ignore the example file so team members know what variables are needed
!.env.example

# ####################################################################
# 4. Logs and Diagnostic Files
# ####################################################################
# Debug logs generated by npm, yarn, or pnpm errors
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ####################################################################
# 5. IDE / Editor Configurations
# ####################################################################
# System-specific files (like Mac Finder files)
.DS_Store
Thumbs.db

# JetBrains IDEs (WebStorm, IntelliJ)
.idea/
*.iws
*.iml
*.ipr

# VS Code project settings (Optional: omit if you share project-wide settings)
.vscode/
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace

# ####################################################################
# 6. Testing & Coverage
# ####################################################################
# Code coverage reports from Jest or Vitest
coverage/
*.lcov

# Playwright or Cypress test artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/
